# Mergelith Infrastructure
# Environment Configuration

# Gemini API Key for Assistant
# The platform provides this automatically in most cases.
# If using a paid model, ensure this is set in the AI Studio settings.
GEMINI_API_KEY=

# SMTP Configuration for Notifications (e.g., SendGrid, Resend, or your email provider)
# These are required to receive subscription notifications to sasha@mergelith.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mergelith.com
NOTIFICATION_EMAIL=sasha@mergelith.com
